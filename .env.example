# Public values. The browser can see anything prefixed with NUXT_PUBLIC_.
# Full site address with no trailing slash, e.g. https://cue.app. Used in share previews and the sitemap.
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Do not prefix these with NUXT_PUBLIC_.
# Secret key writes interview feedback from the ElevenLabs webhook. Never expose it to the browser.
NUXT_SUPABASE_SECRET_KEY=
NUXT_XAI_BASE_URL=
NUXT_XAI_AUTH_KEY=
NUXT_XAI_MODEL=
NUXT_XAI_MAX_TOKENS=
NUXT_ELEVENLABS_API_KEY=
NUXT_ELEVENLABS_AGENT_ID=
NUXT_ELEVENLABS_WEBHOOK_SECRET=
